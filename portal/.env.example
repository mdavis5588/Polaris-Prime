# Copy this file to .env and fill in what you need. .env is gitignored —
# never commit real credentials.
#
# Same philosophy as the earlier Backstage version: leave anything you
# don't have real values for commented out or unset — this app is built
# to run (catalog + placeholders) without any of the Azure AD / NetBox
# integration configured, and to only light those features up once they
# are.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-real-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (see docker-compose.yml for a one-command local instance) ---
POSTGRES_DB=polaris_portal
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Microsoft (Entra ID / Azure AD) sign-in. An app registration with a
# Web redirect URI of <site>/accounts/microsoft/login/callback/, and the
# User.Read delegated scope (django-allauth's default). Sign-in stays
# disabled — no Microsoft button shown — until all three are set.
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# --- Platform tenants: Microsoft Graph app-only credentials for live
# AD-group membership checks (tenants/graph.py). Can reuse the same app
# registration as sign-in above (leave these two unset to do that), or a
# separate one — either way it needs the GroupMember.Read.All (or
# Directory.Read.All) Graph API APPLICATION permission, admin-consented
# in your Azure AD tenant.
# AZURE_AD_GRAPH_CLIENT_ID=
# AZURE_AD_GRAPH_CLIENT_SECRET=

# --- Per-tenant Azure service principal secrets, for real Resource
# Group/NSG provisioning in a Tenant with azure_* fields set via /admin/.
# Deliberately not a database field — never committed, never in the DB.
# Name is TENANT_<TENANT_ID>_AZURE_CLIENT_SECRET with tenant_id upper-cased
# and hyphens turned to underscores, e.g. tenant_id "tenant-1" ->
# TENANT_TENANT_1_AZURE_CLIENT_SECRET=

