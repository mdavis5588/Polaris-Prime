# Copy this file to .env and UNCOMMENT + fill in only what you actually
# need. .env is gitignored — never commit real credentials.
# `yarn start` loads .env automatically.
#
# IMPORTANT: leave everything you don't need commented out. A variable
# that's set-but-empty (e.g. `GITHUB_TOKEN=`) is NOT the same as unset to
# Backstage — an empty string fails config validation for required fields
# and can take down the whole backend (this bit us once; don't repeat it).
# An uncommented, truly absent variable is safely ignored.

# --- GitHub integration (integrations.github in app-config.yaml) ---
# GITHUB_TOKEN=

# --- Optional: GitHub Enterprise, if you uncomment that block in app-config.yaml ---
# GHE_TOKEN=

# --- Optional: backend service-to-service auth secret, if you uncomment
# that block in app-config.yaml (backend.auth.keys) ---
# BACKEND_SECRET=

# --- Production Postgres (app-config.production.yaml — not loaded during
# local `yarn start`, only relevant for production deploys) ---
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- OCI provisioning (oracleDbaas.oci in app-config.yaml) ---
# OCI_REGION=
# OCI_TENANCY_OCID=
# OCI_USER_OCID=
# OCI_FINGERPRINT=
# OCI_PRIVATE_KEY=
# OCI_PRIVATE_KEY_PASSPHRASE=   # only if the key above is encrypted
# OCI_COMPARTMENT_ID=
# OCI_AVAILABILITY_DOMAIN=
# OCI_SUBNET_ID=
# OCI_SSH_PUBLIC_KEY=

# --- Azure provisioning (oracleDbaas.azure in app-config.yaml) ---
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_RESOURCE_GROUP=
# AZURE_LOCATION=
# AZURE_SUBNET_ID=

# --- Helios/SAM-tool pricing integration (samTool.database in app-config.yaml) ---
# Create this user with scripts/create_sam_tool_readonly_user.sh — see README.md.
# SAM_TOOL_DB_HOST=
# SAM_TOOL_DB_PORT=5432
# SAM_TOOL_DB_NAME=
# SAM_TOOL_DB_READONLY_USER=
# SAM_TOOL_DB_READONLY_PASSWORD=
